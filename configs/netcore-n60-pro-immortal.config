# ============================================================================
# 代理工具（momo / meow / easytier / nikki 等）本体不装进固件，
# 只预装它们运行必须的依赖 + sing-box（momo 的硬依赖，官方源里没有，只能自己编）。
# kmod 与内核强绑定，只能在固件里预装，事后无法从官方仓库补装（ABI/vermagic 不匹配）。
# ============================================================================

# 用户态工具：
#   ca-bundle 证书链（订阅/API 下载）
#   curl      订阅与规则下载
#   firewall4 nft 规则框架（momo / meow 都基于 fw4）
#   ip-full   ip rule / ip route（策略路由、fwmark、TUN）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip-full=y

# 内核模块：
#   kmod-tun            TUN 模式
#   kmod-dummy          dummy 网卡（momo 会用到）
#   kmod-nft-tproxy     TProxy（自动带上 kmod-nf-tproxy / nft-core / conntrack）
#   kmod-nft-socket     socket 匹配（自动带上 kmod-nf-socket）
#   kmod-nft-nat        重定向 / SNAT / DNAT
#   kmod-nft-fib        fib 表达式（分流规则里常用）
#   kmod-inet-diag      socket 诊断（按进程 / uid 匹配）
#   kmod-netlink-diag
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# sing-box：来自 kenzok8/small-package 的源（DIY 脚本里替换 feeds/packages/net/sing-box），
# momo 的 DEPENDS 里带 +sing-box，不预装的话以后 apk add momo 会因缺依赖失败。
# 依赖 kmod-tun / kmod-netlink-diag（上面已选）；编译需要较新的 golang，
# DIY 脚本里用 sbwml/packages_lang_golang 替换了内置 golang feed。
CONFIG_PACKAGE_sing-box=y
